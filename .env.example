DATABASE_URL=postgres://user:pass@localhost:5432/payments_engine?sslmode=disable  # required
REDIS_ADDR=localhost:6379         # enables persistent idempotency storage
LISTEN_ADDR=:8080                 # optional; default :8080
SERVICE_NAME=payments-engine      # optional; tags log output
APP_ENV=development               # optional; development | production
CLEARING_ACCOUNT_CODE=GL_LIAB_CLEARING  # optional; monitored by /health/clearing
